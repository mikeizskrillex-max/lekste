# Lėkštė v2 — environment variables. Copy to .env.local for development.
# Values marked "public" are sent to the browser; everything else stays on the server.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.finoraai.solutions   # public; canonical URLs, email links

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=                             # public
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=                 # public (sb_publishable_…)
SUPABASE_SECRET_KEY=                                  # server only (sb_secret_…): admin, cron, webhooks
SUPABASE_DB_URL=                                      # server/CI only: migrations and pgTAP tests

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=                                    # server only
AI_MODEL=claude-sonnet-5-5                            # assistant chat
AI_RECIPE_MODEL=claude-opus-5-5                       # recipe generation and translation (scripts)
AI_DAILY_BUDGET_EUR=5                                 # hard stop for AI spend per day

# --- Stripe (test keys until the company details are in) ---
STRIPE_SECRET_KEY=                                    # server only (sk_test_… / sk_live_…)
STRIPE_WEBHOOK_SECRET=                                # server only (whsec_…)
STRIPE_PRICE_MONTHLY=                                 # price id, 9,00 € / 30 d
STRIPE_PRICE_QUARTERLY=                               # price id, 20,00 € / 90 d
STRIPE_PRICE_LIFETIME=                                # price id, 80,00 € one-time

# --- Email (Resend) ---
RESEND_API_KEY=                                       # server only
EMAIL_FROM="Lėkštė <labas@finoraai.solutions>"

# --- Anti-abuse (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                       # public
TURNSTILE_SECRET_KEY=                                 # server only

# --- Price collection (GitHub Actions, Mondays) ---
SCRAPER_USER_AGENT="LeksteBot/2.0 (+https://www.finoraai.solutions/kontaktai)"
SCRAPER_DELAY_MS=2000
PRICE_MAX_AGE_DAYS=14

# --- Misc ---
CRON_SECRET=                                          # server only: protects /api/cron/* routes
ANALYTICS_SALT=                                       # server only: daily visitor hash
