# ---------------------------------------------------------------
# Lėkštė environment. Copy to .env.local. Every integration is
# optional: when a key is missing the app runs in clearly labelled
# local development mode (mock data, no real payments/emails/AI).
# ---------------------------------------------------------------

# Public site URL (used for magic links, Stripe redirects, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Auth, Postgres, Storage). Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose. Used for webhooks and admin imports.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Billing + Checkout). Test mode keys first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the plans configured in src/config/plans.ts
STRIPE_PRICE_INTRO_2W=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=

# AI provider: "anthropic" or "rules" (local rule-based parser, default)
AI_PROVIDER=rules
ANTHROPIC_API_KEY=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Lėkštė <labas@example.com>"

# Development-mode admin passphrase for /admin when Supabase is not configured
DEV_ADMIN_PASSPHRASE=lekste-admin
# Signs development-mode session cookies (required in production if Supabase is not configured)
SESSION_SECRET=
# Optional: override the AI model used by the anthropic provider
AI_MODEL=
# Retailer catalogue fetching from the admin panel is off unless explicitly enabled
RETAILER_FETCH_ENABLED=false
